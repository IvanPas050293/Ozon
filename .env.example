# ===== Настройки бота для запуска в Docker =====
# Скопируйте этот файл в .env:  cp .env.example .env
# и заполните значения. Файл .env в git не попадает (см. .gitignore).

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Имя бота (можно оставить по умолчанию)
BOT_USERNAME=ozon_analytics_bot

# Система налогообложения: 1=УСН Доходы, 2=УСН Доходы-Расходы, 3=не считать налог, 4=от оплаты на Р/С
TAX_SYSTEM=1

# Ставка налога (0.06 = УСН 6%)
TAX_RATE=0.06

# Разрешённые chat_id через запятую (пусто = открыт всем; в проде лучше заполнить)
ALLOWED_CHAT_IDS=
